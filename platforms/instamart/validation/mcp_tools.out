event: message
data: {"jsonrpc":"2.0","id":2,"result":{"tools":[{"name":"search_products","description":"Search for products on a quick commerce platform by keyword and location.\n\n    Returns product names, brands, prices (MRP & offer price), ratings,\n    inventory counts, images, and deeplinks.\n\n    Args:\n        query: Search term (e.g. \"milk\", \"atta 5kg\", \"Amul Butter\")\n        platform: Platform name — one of: BlinkIt, Zepto, Swiggy, BigBasket, DMart, JioMart, Minutes\n        lat: Latitude of delivery location (e.g. 12.9021 for Bangalore)\n        lon: Longitude of delivery location (e.g. 77.6639 for Bangalore)\n        pincode: 6-digit Indian pincode (REQUIRED for DMart, JioMart, Minutes)\n        api_key: Your QuickCommerce API key\n\n    Costs: 1 credit per call.\n    ","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"platform":{"title":"Platform","type":"string"},"lat":{"title":"Lat","type":"number"},"lon":{"title":"Lon","type":"number"},"pincode":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pincode"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["query","platform","lat","lon"],"title":"search_productsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"search_productsOutput","type":"object"}},{"name":"get_item_details","description":"Get real-time price, stock, and availability for a specific product.\n\n    Args:\n        item_id: Platform-specific item ID (from search_products results)\n        platform: Platform name\n        lat: Latitude\n        lon: Longitude\n        pincode: 6-digit Indian pincode (for DMart, JioMart, Minutes)\n        api_key: Your QuickCommerce API key\n\n    Costs: 1 credit per call.\n    ","inputSchema":{"properties":{"item_id":{"title":"Item Id","type":"string"},"platform":{"title":"Platform","type":"string"},"lat":{"title":"Lat","type":"number"},"lon":{"title":"Lon","type":"number"},"pincode":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pincode"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["item_id","platform","lat","lon"],"title":"get_item_detailsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"get_item_detailsOutput","type":"object"}},{"name":"check_delivery_eta","description":"Get estimated delivery time and store availability for a platform.\n\n    Args:\n        platform: Platform name\n        lat: Latitude\n        lon: Longitude\n        pincode: 6-digit Indian pincode (REQUIRED for DMart, JioMart, Minutes)\n        api_key: Your QuickCommerce API key\n\n    Costs: 1 credit per call.\n    ","inputSchema":{"properties":{"platform":{"title":"Platform","type":"string"},"lat":{"title":"Lat","type":"number"},"lon":{"title":"Lon","type":"number"},"pincode":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pincode"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["platform","lat","lon"],"title":"check_delivery_etaArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"check_delivery_etaOutput","type":"object"}},{"name":"group_search","description":"Search products across MULTIPLE platforms in one call.\n\n    Args:\n        query: Search term\n        platforms: Comma-separated platform names (e.g. \"BlinkIt,Zepto,Swiggy\")\n        lat: Latitude\n        lon: Longitude\n        pincode: 6-digit pincode (if querying DMart, JioMart, or Minutes)\n        api_key: Your QuickCommerce API key\n\n    Costs: 1 credit PER platform.\n    ","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"platforms":{"title":"Platforms","type":"string"},"lat":{"title":"Lat","type":"number"},"lon":{"title":"Lon","type":"number"},"pincode":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pincode"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["query","platforms","lat","lon"],"title":"group_searchArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"group_searchOutput","type":"object"}},{"name":"group_eta","description":"Get delivery ETAs from MULTIPLE platforms in one call.\n\n    Args:\n        platforms: Comma-separated platform names\n        lat: Latitude\n        lon: Longitude\n        pincode: 6-digit pincode (if querying DMart, JioMart, or Minutes)\n        api_key: Your QuickCommerce API key\n\n    Costs: 1 credit PER platform.\n    ","inputSchema":{"properties":{"platforms":{"title":"Platforms","type":"string"},"lat":{"title":"Lat","type":"number"},"lon":{"title":"Lon","type":"number"},"pincode":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Pincode"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["platforms","lat","lon"],"title":"group_etaArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"group_etaOutput","type":"object"}},{"name":"check_credits","description":"Check your remaining QuickCommerce API credits. FREE — costs 0 credits.\n\n    Args:\n        api_key: Your QuickCommerce API key\n    ","inputSchema":{"properties":{"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"title":"check_creditsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"check_creditsOutput","type":"object"}},{"name":"list_platforms","description":"List all 7 supported quick commerce platforms. FREE — no API key needed.","inputSchema":{"properties":{},"title":"list_platformsArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"list_platformsOutput","type":"object"}},{"name":"list_api_history","description":"List your past API calls (search, item, eta, etc.) for this account only.\n\n    Returns request IDs, endpoints, params, status codes, and whether a full response\n    is stored. Use get_api_history_response with a request_id to fetch the JSON body.\n\n    Args:\n        api_key: Your QuickCommerce API key\n        page: Page number (default 1)\n        limit: Results per page, 1–100 (default 20)\n        endpoint: Optional filter, e.g. \"/v1/search\" or \"/v1/item\"\n\n    FREE — does not consume API credits.\n    ","inputSchema":{"properties":{"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"},"page":{"default":1,"title":"Page","type":"integer"},"limit":{"default":20,"title":"Limit","type":"integer"},"endpoint":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Endpoint"}},"title":"list_api_historyArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"list_api_historyOutput","type":"object"}},{"name":"get_api_history_response","description":"Get the stored JSON response for one of your past API calls.\n\n    Only returns data for requests made with your API key (your account only).\n\n    Args:\n        request_id: Request ID from list_api_history\n        api_key: Your QuickCommerce API key\n\n    FREE — does not consume API credits.\n    ","inputSchema":{"properties":{"request_id":{"title":"Request Id","type":"string"},"api_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Api Key"}},"required":["request_id"],"title":"get_api_history_responseArguments","type":"object"},"outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"get_api_history_responseOutput","type":"object"}}]}}

