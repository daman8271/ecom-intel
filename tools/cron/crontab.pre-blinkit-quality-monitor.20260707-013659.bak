30 16 * * * /root/jivo-pincode-app/build_and_deploy.sh >> /root/jivo-pincode-app/build_deploy.log 2>&1   # jivo-pincode-app safety-net redeploy
# >>> jivo-today snapshot (managed by Claude 2026-07-01) >>>
