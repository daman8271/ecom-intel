# Every 15 min: commit crawler/scraper output in the data vaults + push ALL
# owner (daman8271) repos that have unpushed commits. ASAP cadence.
*/15 * * * * COMMIT_VAULTS=1 QUIET=1 /root/bin/push_all_repos.sh >> /var/log/jivo-pushall/cron.log 2>&1
# <<< jivo push-all (auto GitHub sync) <<<
0 */12 * * * /root/jivo-data-bank/bin/coverage_12h.sh >> /var/log/jivo-data-bank/coverage_sync.log 2>&1   # coverage 12h sync (ecom-intel ledger -> data bank, push if missing)
0 3 * * * /root/jivo-competitor-warroom/refresh.sh >> /root/jivo-competitor-warroom/refresh.log 2>&1   # jivo-competitor-warroom nightly
# competitor scrape + data-bank fusion are now EVENT-DRIVEN off the noon sweep (goal #35, 2026-07-01) — removed fixed 12:15 competitor + 13:30 data-bank lines
