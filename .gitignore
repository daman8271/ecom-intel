node_modules/
node_modules
platforms/*/node_modules
output/
logs/
# Combined JIVO x ecom data bank: the on-disk copy REMAINS here (per owner) but
# is a large derived artifact packaged as its own standalone private repo
# (jivo-data-bank) — do NOT bloat this repo with it. Generators live in bin/.
**/result.json
# guardian "keep last-good" fallback snapshot — runtime data, same class as result.json
**/result.last-good.json
**/Jivo-*.xlsx
*.log
.DS_Store
secrets.env
secrets/
**/secrets/
__pycache__/
.gitpush.lock
.amazon-account.lock
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# captured session/network/recon artifacts (may embed tokens) — never commit
**/cookies*.json
**/net.*.jsonl
**/nowstore.*.json
**/spike.*.json
**/investigate*.json
**/*.now.json

# whatsapp tool debug dumps — leak group JIDs / pairing code / phone numbers
tools/whatsapp/*.out
# bigbasket recon captures — large, and header_api.json embeds account/session context
platforms/bigbasket/header_api.json
platforms/bigbasket/listing_raw.json
platforms/bigbasket/listing_inpage.json

# guardian transient "latest" pointers (regenerated every eval; dated reports +
# per-run verdicts + state-<date>.json ARE committed as the audit trail)
reviews/guardian/*-latest.json

# auto-heal reversible snapshots (result.json.bak copies — runtime + embed pricing,
# same class as result.json; the verdict/log audit trail is kept elsewhere)
backups/autoheal/

# --- Obsidian: config + enabled plugins are tracked for fresh-clone bootstrap, but
# keep machine-specific / runtime-credential state OUT of git ---
vault/.obsidian/plugins/*/obsidian_askpass.sh
vault/.obsidian/plugins/*/*.lock
vault/.obsidian/plugins/*/.git/

# --- Obsidian cruft guards: stray files Obsidian creates by accident ---
# Bases stubs (this vault doesn't use Bases)
vault/**/*.base
# "Untitled" placeholders (note / canvas / base)
vault/Untitled*
# Stray daily note created at the vault ROOT (it shadows the real daily/ note and
# hijacks the "Today" link). Leading slash anchors to repo root, so the real
# vault/daily/YYYY-MM-DD.md is NOT matched.
/vault/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
